# @use ./rts/helpers.rts

### List items
# @name List items
GET {{base.url}}/api/items

### List articles only
# @name List articles only
GET {{base.url}}/api/items?kind=article

### List bookmarks only
# @name List bookmarks only
GET {{base.url}}/api/items?kind=bookmark

### List notes only
# @name List notes only
GET {{base.url}}/api/items?kind=note

### List tasks only
# @name List tasks only
GET {{base.url}}/api/items?kind=task

### List videos only
# @name List videos only
GET {{base.url}}/api/items?kind=video

### List new items
# @name List new items
GET {{base.url}}/api/items?status=new

### List done items
# @name List done items
GET {{base.url}}/api/items?status=done

### List items by date
# @name List items by date
GET {{base.url}}/api/items?date=2026-06-06

### List items by author
# @name List items by author
GET {{base.url}}/api/items?author=aNNiMON

### List items with tags
# @name List items with tags
GET {{base.url}}/api/items?tags=geotagging

### List items excluding tags
# @name List items excluding tags
GET {{base.url}}/api/items?tags=!geotagging

### List 2 items with 1 offset
# @name List items with offset and limit
GET {{base.url}}/api/items?limit=2&offset=1

### List items multiple filters
# @name List items with multiple filters
GET {{base.url}}/api/items?kind=article&status=new&author=aNNiMON&tags=rust,geotagging,maps,!openlayers,!docker&limit=5


### New article item fetching title
# @name New Article item
POST {{base.url}}/api/items
Content-Type: application/json

{
  "url": "https://blog.annimon.com/wezterm-projects/",
  "kind": "article",
  "tags": "wezterm, terminal",
  "created_at": "2026-06-25T10:00:00+03:00"
}


### New bookmark item
# @name New Bookmark item
POST {{base.url}}/api/items
Content-Type: application/json

{
  "url": "https://blog.annimon.com/wezterm-projects/",
  "kind": "bookmark",
  "tags": "wezterm, terminal",
  "created_at": "2026-06-25T10:00:00+03:00"
}


### New note item
# @name New Note item
POST {{base.url}}/api/items
Content-Type: application/json

{
  "kind": "note",
  "title": "New Note",
  "content": "Note content here",
  "created_at": "2026-06-25T10:00:00+03:00"
}


### New task item
# @name New Task item
POST {{base.url}}/api/items
Content-Type: application/json

{
  "kind": "task",
  "title": "ToDo",
  "content": "- Item 1\n- Item 2\n- Item 3",
  "created_at": "2026-06-25T10:00:00+03:00"
}


### Update item status to in_progress
# @name Update item status to in_progress
PUT {{base.url}}/api/items/20260625 WezTerm projects selector/status
Content-Type: application/json

{
  "status": "in_progress"
}

### Update item status to new
# @name Update item status to new
PUT {{base.url}}/api/items/20260625 WezTerm projects selector/status
Content-Type: application/json

{
  "status": "new"
}

### Update item tags
# @name Update item tags
PUT {{base.url}}/api/items/20260625 WezTerm projects selector/tags
Content-Type: application/json

{
  "tags": "wezterm, terminal, updated"
}

### Delete item
# @name Delete item
DELETE {{base.url}}/api/items/20260704 Simple task

### Generate AI summary
# @name Generate AI summary
PUT {{base.url}}/api/items/20260625 WezTerm projects selector/ai
Content-Type: application/json

{
  "feature": "summary"
}

### Generate AI mindmap
# @name Generate AI mindmap
PUT {{base.url}}/api/items/20260625 WezTerm projects selector/ai
Content-Type: application/json

{
  "feature": "mindmap"
}

### List item attachments
# @name List item attachments
GET {{base.url}}/api/items/20260625 WezTerm projects selector/attachments

### Add note.md attachment
### curl -X POST "http://127.0.0.1:8555/api/items/20260625%20WezTerm%20projects%20selector/attachments" -F 'file=@mprocs.yaml;filename=metadata.json;type=text/yaml'
# @name Add note.md attachment
POST {{base.url}}/api/items/20260625 WezTerm projects selector/attachments
Content-Type: multipart/form-data; boundary=resterm-415585af9536eb485a5ca2c5

--resterm-415585af9536eb485a5ca2c5
Content-Disposition: form-data; name="file"; filename="note.md"
Content-Type: text/markdown

@mprocs.yaml
--resterm-415585af9536eb485a5ca2c5--

### Delete note.md attachment
# @name Delete note.md attachment
DELETE {{base.url}}/api/items/20260625 WezTerm projects selector/attachments/note.md

### Health
# @name Health
GET {{base.url}}/api/health

### Config AI
# @name Config AI
GET {{base.url}}/api/config/ai